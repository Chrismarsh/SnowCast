{
  "name": "snowcast-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "refresh:downloads": "python -m snowcast_runner.downloads --output public/download-index.json",
    "prebuild": "python ../scripts/unpack_canswe.py && npm run refresh:downloads -- --allow-stale",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run src",
    "demo": "python ../scripts/make_webui_demo.py",
    "predev": "python ../scripts/unpack_canswe.py",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "geotiff": "3.0.5",
    "ol": "10.11.0",
    "proj4": "^2.19.0",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@napi-rs/canvas": "0.1.100",
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "^24.0.0",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "8.3.6",
    "vitest": "^4.0.0"
  }
}
